{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@opencode/plugin/tui": ["./types/@opencode/plugin/tui/index.d.ts"],
      "@opencode/client": ["./types/@opencode/client/index.d.ts"]
    },
    "lib": ["ES2022"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "types/**/*"]
}
